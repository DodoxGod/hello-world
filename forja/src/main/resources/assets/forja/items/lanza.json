              {
                "type": "minecraft:custom_model_data",
                "index": 0,
                "default": 15000804
              }
            ]
          },
          {
            "type": "minecraft:model",
            "model": "forja:item/lanza/mano_1",
            "tints": [
              {
                "type": "minecraft:custom_model_data",
                "index": 1,
                "default": 12093775
              }
            ]
          },
          {
            "type": "minecraft:model",
            "model": "forja:item/lanza/mano_2",
            "tints": [
              {
                "type": "minecraft:custom_model_data",
                "index": 2,
                "default": 12093775
              }
            ]
          }
        ]
      }
    }
