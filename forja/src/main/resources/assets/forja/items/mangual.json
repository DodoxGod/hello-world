{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:broken",
    "on_true": {
      "type": "minecraft:composite",
      "models": [
        {
          "type": "minecraft:composite",
          "models": [
            {
              "type": "minecraft:model",
              "model": "forja:item/mangual/0",
              "tints": [
                {
                  "type": "minecraft:custom_model_data",
                  "index": 0,
                  "default": 15000804
                }
              ]
            },
            {
              "type": "minecraft:model",
              "model": "forja:item/mangual/1",
              "tints": [
                {
                  "type": "minecraft:custom_model_data",
                  "index": 1,
                  "default": 12093775
                }
              ]
            },
            {
              "type": "minecraft:select",
              "property": "minecraft:custom_model_data",
              "index": 2,
              "cases": [
                {
                  "when": "pesado",
                  "model": {
                    "type": "minecraft:model",
                    "model": "forja:item/mangual/2_pesado",
                    "tints": [
                      {
                        "type": "minecraft:custom_model_data",
                        "index": 2,
                        "default": 12093775
                      }
                    ]
                  }
                },
                {
                  "when": "ligero",
                  "model": {
                    "type": "minecraft:model",
                    "model": "forja:item/mangual/2_ligero",
                    "tints": [
                      {
                        "type": "minecraft:custom_model_data",
                        "index": 2,
                        "default": 12093775
                      }
                    ]
                  }
                }
              ],
              "fallback": {
                "type": "minecraft:model",
                "model": "forja:item/mangual/2",
                "tints": [
                  {
                    "type": "minecraft:custom_model_data",
                    "index": 2,
                    "default": 12093775
                  }
                ]
              }
            }
          ]
        },
        {
          "type": "minecraft:select",
          "property": "minecraft:display_context",
          "cases": [
            {
              "when": "gui",
              "model": {
                "type": "minecraft:model",
                "model": "forja:item/grieta"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:empty"
          }
        }
      ]
    },
    "on_false": {
      "type": "minecraft:composite",
      "models": [
        {
          "type": "minecraft:model",
          "model": "forja:item/mangual/0",
          "tints": [
            {
              "type": "minecraft:custom_model_data",
              "index": 0,
              "default": 15000804
            }
          ]
        },
        {
          "type": "minecraft:model",
          "model": "forja:item/mangual/1",
          "tints": [
            {
              "type": "minecraft:custom_model_data",
              "index": 1,
              "default": 12093775
            }
          ]
        },
        {
          "type": "minecraft:select",
          "property": "minecraft:custom_model_data",
          "index": 2,
          "cases": [
            {
              "when": "pesado",
              "model": {
                "type": "minecraft:model",
                "model": "forja:item/mangual/2_pesado",
                "tints": [
                  {
                    "type": "minecraft:custom_model_data",
                    "index": 2,
                    "default": 12093775
                  }
                ]
              }
            },
            {
              "when": "ligero",
              "model": {
                "type": "minecraft:model",
                "model": "forja:item/mangual/2_ligero",
                "tints": [
                  {
                    "type": "minecraft:custom_model_data",
                    "index": 2,
                    "default": 12093775
                  }
                ]
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "forja:item/mangual/2",
            "tints": [
              {
                "type": "minecraft:custom_model_data",
                "index": 2,
                "default": 12093775
              }
            ]
          }
        }
      ]
    }
  }
}
