 "compatibilidad": "Una red con \"contrato_version\": 2 (253 entradas, 68 salidas) va por este contrato; una sin él (o 1) por el de v1 (213 → 60), que el mod tiene que seguir cargando igual.",
 "entradas_nuevas": {
  "0..212": "las 213 de v1, iguales; el bloque O (199..212) pone las órdenes nuevas como las ven los mobs: CERRAR_SALIDAS = cercar, FOCO_HERIDO = ninguna, RETIRADA_FALSA = retirada (antes del ataque) o carga (después)",
  "213..224 regla_orden_*": "one-hot de la orden que daría Captain.rules() AHORA (12: las 9 de v1 + cerrar_salidas, foco_herido, retirada_falsa; las reglas nunca dan las 3 nuevas; con un interino, CARGA → ninguna)",
  "225..228 regla_formacion_*": "one-hot de su formación",
  "229..232 regla_cuenta_*": "one-hot de su cuenta (0/10/20/40)",
  "233..235 orden_cerrar_salidas / orden_foco_herido / orden_retirada_falsa": "la orden actual es una de las nuevas",
  "236 falsa_ataque": "RETIRADA_FALSA ya pasó al ataque",
  "237 capitan_interino": "manda un veterano interino (sucesión)",
  "238 sin_mando": "1 → 0 en los 200 ticks tras la muerte del capitán anterior",
  "239 capitan_tras_frente/8": "(distancia del capitán al jugador − la del miembro de cuerpo a cuerpo más cercano) / 8, ±2",
  "240 escoltas/2": "miembros a < 3 del capitán",
  "241 jug_mira_capitan": "el jugador lo ve en un cono de 30°",
  "242 capitan_golpeado/3": "golpes del jugador al capitán en 100 ticks",
  "243 compartida/8": "miembros que recibieron la estimación compartida en el último pase",
  "244 jug_aleja/0.2": "velocidad del jugador alejándose del centro del grupo (±2)",
  "245 salidas_libres/8": "de las 8 direcciones, las que a 4 bloques no suben más de 1 y se ven",
  "246..249 otro_jug_presente, otro_vida_frac, otro_dist/16, mi_jug_vida_frac": "el otro jugador (2 jugadores) y el mío",
  "250..252 proteccion_*": "el modo de protección en vigor (regla, sin, retirada)"
 },
 "combinar_salidas": [
  "mando = argmax(logits[66], logits[67]) SIN temperatura ni sorteo (0 = seguir la regla)",
  "mando 0: la orden de Captain.rules() tal cual (puestos por tipo) y protección 0 (regla)",
  "mando 1: se sortean con logits/T y su máscara orden (0..11), formacion, sector, cuenta, foco, puesto0..7 y proteccion (0 regla, 1 sin proteger, 2 retirarse ya), como en v1"
 ],
 "mascara": {
  "orden_asedio": "jugador con sobre el suelo ≥ 2 o en torre",
